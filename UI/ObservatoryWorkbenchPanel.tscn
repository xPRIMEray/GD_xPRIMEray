[node name="PresentationControls" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="OpticalOnlyCheck" type="CheckButton" parent="Margin/Root/PresentationControls"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Hide conventional Godot world rendering from the observer camera only. Transport and collision geometry remain active."
text = "Optical-only world"

[node name="DemoModeCheck" type="CheckButton" parent="Margin/Root/PresentationControls"]
layout_mode = 2
tooltip_text = "Select optical-only presentation, hide advanced telemetry, and suppress internal development annotations."
text = "Demo mode"

[node name="PresentationStatus" type="Label" parent="Margin/Root"]
layout_mode = 2
